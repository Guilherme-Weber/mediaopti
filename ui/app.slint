// mediaopti interface: Windows 11 Fluent design (dark), rendered by Slint's software renderer.

import { Button, ComboBox, ListView, ScrollView, Switch } from "std-widgets.slint";

// A file being processed on the CPU; `progress` < 0 when its share done isn't known.
export struct FileRow {
    name: string,
    meta: string,
    progress: float,
}

// One external tool on the About page.
export struct ToolRow {
    name: string,
    version: string,
    source: string,
}

// One maximum-effort part on the Advanced page.
export struct AdvPart {
    name: string,
    label: string,
    detail: string,
    on: bool,
}

export struct WorkerRow {
    title: string,
    meta: string,
    progress: float,
}

export struct Metric {
    label: string,
    value: string,
    glyph: string,
}

// Design tokens (Windows 11 dark theme values).
export global Theme {
    in property <string> icon-font: "Segoe Fluent Icons";
    out property <brush> window-background: #202020;
    out property <brush> card-background: #2B2B2B;
    out property <brush> card-stroke: #1C1C1C;
    out property <brush> subtle-fill: #FFFFFF0F;
    out property <brush> text: #FFFFFF;
    out property <brush> text-secondary: #FFFFFFC9;
    out property <brush> text-tertiary: #FFFFFF8A;
    // One accent (Windows 11 dark accent text/fill) for links, progress, focus and "running".
    out property <color> accent: #60CDFF;
    out property <color> accent-hover: #99EBFF;
    out property <brush> well-background: #1C1C1C;
    out property <color> success: #6CCB5F;
    out property <color> caution: #FCE100;
    out property <color> critical: #FF99A4;
    out property <color> neutral: #9D9D9D;
    // Radius scale: cards and tiles 8px, inner wells and focus rings 4px, bars and pills fully round.
    out property <length> radius: 8px;
    out property <length> radius-small: 4px;
}

// Icon from the Segoe Fluent Icons font. Decorative: hidden from screen readers.
component Glyph inherits Text {
    in property <string> glyph;
    text: glyph;
    accessible-role: none;
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Card inherits Rectangle {
    in property <length> pad: 16px;
    in property <length> gap: 12px;
    background: Theme.card-background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    vertical-stretch: 0;
    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> text;
    spacing: 10px;
    Glyph { glyph: root.glyph; font-size: 16px; color: Theme.text-secondary; width: 18px; }
    Text { text: root.text; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
}

component StatusPill inherits Rectangle {
    in property <string> status;
    in property <string> label;
    property <color> tone: status == "error" ? Theme.critical
        : (status == "stopping" || status == "paused") ? Theme.caution
        : (status == "ready" || status == "done") ? Theme.success
        : status == "idle" ? Theme.neutral
        : Theme.accent;
    background: tone.with-alpha(0.12);
    border-color: tone.with-alpha(0.45);
    border-width: 1px;
    border-radius: self.height / 2;
    height: 28px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.tone;
            }
        }
        Text { text: root.label; color: root.tone; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
}

component IconTile inherits Rectangle {
    in property <string> glyph;
    width: 44px;
    height: 44px;
    border-radius: Theme.radius;
    background: Theme.accent.with-alpha(0.12);
    Glyph { glyph: root.glyph; font-size: 20px; color: Theme.accent; }
}

// Text-style button: reachable with Tab, activated with Enter/Space, announced as a button.
component LinkText inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    border-radius: Theme.radius-small;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-tertiary : touch.has-hover ? Theme.accent-hover : Theme.accent;
            font-size: 13px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component SettingField inherits VerticalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <string> hint;
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback changed();
    spacing: 6px;
    // Equal columns regardless of label/hint length, so the dropdowns line up.
    preferred-width: 200px;
    min-width: 0px;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 8px;
        Glyph { glyph: root.glyph; font-size: 14px; color: Theme.text-secondary; width: 16px; }
        Text { text: root.label; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
    }
    ComboBox {
        // The widget's own minimum follows its text; ignoring it keeps both columns equal.
        min-width: 0px;
        model: root.model;
        current-index <=> root.current-index;
        enabled: root.enabled;
        selected => { root.changed(); }
    }
    Text { text: root.hint; font-size: 12px; color: Theme.text-tertiary; wrap: word-wrap; }
}

// Keeps a lone setting at half width (same column sizing as SettingField).
component EmptyField inherits Rectangle {
    preferred-width: 200px;
    min-width: 0px;
    horizontal-stretch: 1;
}

// One figure inside the metrics card: icon + label, value underneath.
component MetricCell inherits VerticalLayout {
    in property <Metric> metric;
    spacing: 4px;
    // Same preferred width and stretch for every cell, so each row splits evenly.
    preferred-width: 100px;
    min-width: 0px;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 6px;
        Glyph { glyph: root.metric.glyph; font-size: 12px; color: Theme.text-tertiary; width: 14px; }
        Text { text: root.metric.label; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
    }
    Text { text: root.metric.value; font-size: 18px; font-weight: 600; color: Theme.text; overflow: elide; }
}

component ThinBar inherits Rectangle {
    in property <float> progress;
    in property <brush> fill: Theme.accent;
    height: 4px;
    border-radius: 2px;
    background: Theme.subtle-fill;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: 250ms; easing: ease-out; }
    }
}

// One line per file: name, what it is doing, and a short bar when its share done is known.
component FileLine inherits HorizontalLayout {
    in property <FileRow> file;
    spacing: 8px;
    min-height: 20px;
    Text { text: root.file.name; font-size: 12px; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
    Text { text: root.file.meta; font-size: 11px; color: Theme.text-tertiary; horizontal-stretch: 0; vertical-alignment: center; }
    Rectangle {
        width: 48px;
        if root.file.progress >= 0: ThinBar { y: (parent.height - self.height) / 2; width: parent.width; progress: root.file.progress; }
    }
}

export struct QueueItem {
    name: string,
    kind: string,
    size: string,
}

export struct QueueCount {
    label: string,
    count: string,
    size: string,
    glyph: string,
}

// One entry of the side navigation (WinUI NavigationView style): icon, label, and a short
// accent pill on the left when selected.
component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    in property <bool> compact;
    // A dot on the icon (an update is available).
    in property <bool> badge;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.subtle-fill : touch.has-hover ? #FFFFFF0A : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;
        Glyph { glyph: root.glyph; font-size: 16px; width: 18px; color: Theme.text; }
        if !root.compact: Text { text: root.text; font-size: 14px; color: Theme.text; vertical-alignment: center; }
    }
    if root.badge: Rectangle {
        x: 28px;
        y: parent.height / 2 - 11px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Header of a settings card: icon, title, accepted formats, and an on/off switch.
component GroupHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> formats;
    in property <bool> has-switch: true;
    in property <bool> enabled: true;
    in-out property <bool> on: true;
    callback toggled();
    spacing: 12px;
    Glyph { glyph: root.glyph; font-size: 18px; color: Theme.accent; width: 20px; }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.title; font-size: 15px; font-weight: 600; color: Theme.text; }
        if root.formats != "": Text { text: root.formats; font-size: 12px; color: Theme.text-tertiary; wrap: word-wrap; }
    }
    if root.has-switch: VerticalLayout {
        alignment: center;
        Switch {
            text: root.on ? "On" : "Off";
            enabled: root.enabled;
            checked <=> root.on;
            toggled => { root.toggled(); }
        }
    }
}

// A checkbox drawn from its state only (no internal state), so "All" can follow the others.
component Check inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: Theme.radius-small;
                border-width: root.checked ? 0px : 1px;
                border-color: #FFFFFF8A;
                background: !root.enabled ? #FFFFFF14 : root.checked ? Theme.accent : #00000033;
                if root.checked: Glyph { glyph: "\u{E73E}"; font-size: 12px; color: #000000; }
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: root.enabled ? Theme.text : Theme.text-tertiary;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One type in the queue summary: icon, count, size.
component CountTile inherits Rectangle {
    in property <QueueCount> item;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 100px;
    background: Theme.card-background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Glyph { glyph: root.item.glyph; font-size: 20px; color: Theme.accent; width: 22px; }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.count; font-size: 18px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: root.item.label + " · " + root.item.size; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
        }
    }
}

// A bar for work without a known end (scanning): a segment sliding across.
component BusyBar inherits Rectangle {
    height: 4px;
    border-radius: 2px;
    background: Theme.subtle-fill;
    clip: true;
    Rectangle {
        width: parent.width * 0.25;
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.accent;
        x: (Math.mod(animation-tick() / 1ms, 1600) / 1600) * (parent.width * 1.25) - self.width;
    }
}

component PageTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> status;
    in property <string> status-label;
    spacing: 12px;
    Text { text: root.text; font-size: 26px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    if root.status != "idle" && root.status != "": VerticalLayout {
        alignment: center;
        StatusPill { status: root.status; label: root.status-label; horizontal-stretch: 0; }
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1180px;
    preferred-height: 860px;
    min-width: 820px;
    min-height: 640px;
    background: Theme.window-background;
    default-font-size: 14px;

    // ---- state pushed from Rust
    in property <string> status: "idle";
    in property <string> status-label: "Idle";
    in property <string> window-title: "mediaopti";
    in property <bool> has-folder;
    in property <bool> empty-folder;
    in property <string> folder-title: "No folder selected";
    in property <string> folder-path;
    in property <string> folder-summary: "Choose one or more folders, or drop files and folders on this window.";
    in property <bool> busy;
    in property <bool> scanning;
    in property <bool> processing;
    in property <bool> can-start;
    in property <bool> stop-enabled;
    in property <bool> paused;
    in property <bool> show-options;
    in property <bool> show-stats;
    in property <bool> show-log;
    in property <bool> show-history;
    in property <string> history-text;
    in property <[Metric]> metrics: [
        { label: "Queued", value: "0", glyph: "\u{E8FD}" }, { label: "Completed", value: "0/0", glyph: "\u{E73E}" },
        { label: "Saved", value: "0 MB", glyph: "\u{E74E}" }, { label: "Speed", value: "—", glyph: "\u{EC4A}" },
        { label: "NVENC / VRAM", value: "0% | 0 GB", glyph: "\u{E950}" }, { label: "Failed", value: "0", glyph: "\u{E783}" },
    ];
    in property <float> overall-progress;
    in property <string> overall-percent: "0%";
    in property <string> current-file: "No active file";
    in property <[WorkerRow]> workers;
    // Files running on the CPU, in two columns (read across: left, right, left...).
    in property <[FileRow]> files-left;
    in property <[FileRow]> files-right;
    in property <[string]> log-lines;
    in property <[QueueCount]> queue-counts;
    in property <[QueueItem]> queue-items;
    in property <string> queue-more;
    // ---- about page
    in property <string> app-version;
    in property <string> tools-found;
    in property <string> tools-missing;
    in property <string> data-dir;
    in property <string> update-text: "Checking for updates…";
    // The newer version found, or empty.
    in property <string> update-version;
    in property <bool> update-running;
    // ---- advanced page (reached from About)
    in-out property <bool> gpu-decoding: true;
    in-out property <bool> drop-data: false;
    in-out property <bool> strip: false;
    in-out property <bool> redo-stripped: false;
    in-out property <[AdvPart]> adv-parts;
    in property <bool> adv-default: true;

    // ---- settings (two-way with Rust)
    in property <[string]> encoder-options;
    in property <[string]> jobs-options;
    in property <[string]> quality-options;
    in property <[string]> speed-options;
    in-out property <int> encoder-index;
    in-out property <int> jobs-index;
    in-out property <int> quality-index;
    in-out property <int> speed-index;
    in property <[string]> check-options;
    in property <[string]> gifs-options;
    in property <[string]> originals-options;
    in-out property <int> check-index;
    in-out property <int> gifs-index;
    in-out property <int> originals-index;
    // Backup folder for replaced originals ("" = next to the scanned folder).
    in-out property <string> backup-dir;
    in property <[string]> images-options;
    in-out property <int> images-index;
    in property <[string]> pdf-options;
    in-out property <int> pdf-index;
    in property <[string]> audio-options;
    in-out property <int> audio-index;
    in property <[string]> fix-ext-options;
    in-out property <int> fix-ext-index;
    in-out property <string> temp-dir;
    in property <string> system-temp;
    in-out property <bool> videos-on: true;
    in-out property <bool> images-on: true;
    in-out property <bool> audio-on: true;
    in-out property <bool> docs-on: true;
    in-out property <bool> conv-wav: true;
    in-out property <bool> conv-img: true;
    in-out property <bool> conv-cbr: true;
    // A file is being dragged over the window.
    in property <bool> drop-hover;
    // 0 = queue, 1 = settings, 2 = about.
    in-out property <int> page: 0;
    // The side navigation shows only icons.
    in-out property <bool> nav-compact;
    callback nav-toggled();
    // Flipped by Rust to make the software renderer repaint the whole window.
    in property <bool> repaint-all;

    callback choose-folder();
    callback start();
    callback stop();
    callback toggle-pause();
    callback forget-history();
    callback clear-log();
    callback open-logs();
    callback check-update();
    callback install-update();
    callback check-tools();
    callback install-tools();
    in property <[ToolRow]> tool-rows;
    // New pingo/beeim versions: a line, whether they can be installed, a check running.
    in property <string> tools-new-text;
    in property <bool> tools-new;
    in property <bool> tools-checking;
    callback open-release-page();
    callback toggle-part(int);
    callback advanced-changed();
    callback restore-advanced();
    callback open-data-folder();
    callback settings-changed();
    callback restore-defaults();
    callback choose-backup-folder();
    callback choose-temp-folder();
    callback clear-queue();

    // Incremented by Rust after new log lines arrive; the log view scrolls to the end.
    in property <int> log-revision;

    property <bool> locked: root.processing || root.busy;

    HorizontalLayout {
        // ---- navigation pane
        Rectangle {
            width: root.nav-compact ? 64px : 220px;
            background: #1C1C1C;
            VerticalLayout {
                padding: 8px;
                padding-top: 10px;
                spacing: 4px;
                // The menu button switches between icons only and icons with names.
                NavItem {
                    glyph: "\u{E700}";
                    text: root.nav-compact ? "Show names" : "Hide names";
                    compact: true;
                    clicked => {
                        root.nav-compact = !root.nav-compact;
                        root.nav-toggled();
                    }
                }
                if !root.nav-compact: HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 4px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    Image { source: @image-url("../assets/icon.png"); width: 28px; height: 28px; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "mediaopti"; font-size: 16px; font-weight: 600; color: Theme.text; }
                        Text { text: "Batch media optimizer"; font-size: 11px; color: Theme.text-tertiary; }
                    }
                }
                NavItem { glyph: "\u{E8FD}"; text: "Queue"; compact: root.nav-compact; selected: root.page == 0; clicked => { root.page = 0; } }
                Rectangle { vertical-stretch: 1; }
                NavItem { glyph: "\u{E713}"; text: "Settings"; compact: root.nav-compact; selected: root.page == 1; clicked => { root.page = 1; } }
                NavItem { glyph: "\u{E946}"; text: "About"; compact: root.nav-compact; selected: root.page == 2 || root.page == 3; badge: root.update-version != ""; clicked => { root.page = 2; } }
            }
        }

        // ---- pages
        Rectangle {
            horizontal-stretch: 1;

            // ================= Queue
            if root.page == 0: queue-page := ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, queue-column.preferred-height);

                queue-column := VerticalLayout {
                    width: queue-page.visible-width;
                    height: queue-page.content-height;
                    padding: 24px;
                    padding-left: max(24px, (queue-page.visible-width - 1000px) / 2);
                    padding-right: max(24px, (queue-page.visible-width - 1000px) / 2);
                    spacing: 14px;

                    PageTitle { text: "Queue"; status: root.status; status-label: root.status-label; }

                    // Source and the main actions.
                    Card {
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                IconTile { glyph: "\u{E8B7}"; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: root.folder-title; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                                if root.has-folder: Text { text: root.folder-path; font-size: 12px; color: Theme.text-tertiary; overflow: elide; }
                                Text { text: root.folder-summary; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: root.has-folder ? "Change folders" : "Choose folders";
                                    primary: !root.has-folder || root.empty-folder;
                                    enabled: !root.busy;
                                    clicked => { root.choose-folder(); }
                                }
                            }
                            if root.has-folder && !root.processing: VerticalLayout {
                                alignment: center;
                                Button { text: "Clear queue"; enabled: !root.busy; clicked => { root.clear-queue(); } }
                            }
                            if root.processing: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: root.paused ? "Resume" : "Pause";
                                    primary: root.paused;
                                    enabled: root.stop-enabled;
                                    clicked => { root.toggle-pause(); }
                                }
                            }
                            if root.processing: VerticalLayout {
                                alignment: center;
                                Button { text: "Stop"; enabled: root.stop-enabled; clicked => { root.stop(); } }
                            }
                            if !root.processing: VerticalLayout {
                                alignment: center;
                                Button { text: "Start"; primary: true; enabled: root.can-start && !root.update-running; clicked => { root.start(); } }
                            }
                        }
                        if root.scanning: BusyBar { }
                        if root.show-history: HorizontalLayout {
                            spacing: 12px;
                            Glyph { glyph: "\u{E81C}"; font-size: 13px; color: Theme.text-tertiary; width: 14px; }
                            Text { text: root.history-text; font-size: 13px; color: Theme.text-tertiary; vertical-alignment: center; }
                        }
                    }

                    // Waiting files by type, then the list (not while running).
                    if root.has-folder && !root.processing: HorizontalLayout {
                        spacing: 12px;
                        for c in root.queue-counts: CountTile { item: c; }
                    }
                    if root.has-folder && !root.processing: Card {
                        vertical-stretch: 1;
                        HorizontalLayout {
                            SectionTitle { glyph: "\u{E8FD}"; text: "In processing order"; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.queue-more; font-size: 12px; color: Theme.text-tertiary; vertical-alignment: center; }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 220px;
                            background: Theme.well-background;
                            border-radius: Theme.radius-small;
                            if root.queue-items.length == 0: Text {
                                text: "Nothing waiting: everything here is processed, or its type is switched off in Settings.";
                                font-size: 13px;
                                color: Theme.text-tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            ListView {
                                for item in root.queue-items: HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 12px;
                                    Text { text: item.kind; width: 72px; font-size: 12px; color: Theme.accent; vertical-alignment: center; }
                                    Text { text: item.name; font-size: 13px; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: item.size; font-size: 12px; color: Theme.text-tertiary; horizontal-alignment: right; width: 80px; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    // Running (or just finished): figures, progress, active files.
                    if root.show-stats: Card {
                        pad: 14px;
                        gap: 14px;
                        if root.width >= 1220px: HorizontalLayout {
                            spacing: 16px;
                            for metric in root.metrics: MetricCell { metric: metric; }
                        }
                        if root.width < 1220px: HorizontalLayout {
                            spacing: 16px;
                            MetricCell { metric: root.metrics[0]; }
                            MetricCell { metric: root.metrics[1]; }
                            MetricCell { metric: root.metrics[2]; }
                        }
                        if root.width < 1220px: HorizontalLayout {
                            spacing: 16px;
                            MetricCell { metric: root.metrics[3]; }
                            MetricCell { metric: root.metrics[4]; }
                            MetricCell { metric: root.metrics[5]; }
                        }
                    }
                    if root.show-stats: Card {
                        HorizontalLayout {
                            SectionTitle { glyph: "\u{E9D9}"; text: "Progress"; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.overall-percent; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        }
                        Text { text: root.current-file; font-size: 13px; color: Theme.text-secondary; overflow: elide; }
                        ThinBar { progress: root.overall-progress; height: 6px; border-radius: 3px; }
                        for worker in root.workers: VerticalLayout {
                            spacing: 6px;
                            padding-top: 4px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: worker.title; font-size: 13px; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                                Text { text: worker.meta; font-size: 12px; color: Theme.text-tertiary; horizontal-stretch: 0; }
                            }
                            ThinBar { progress: worker.progress; }
                        }
                        if root.files-left.length > 0: HorizontalLayout {
                            spacing: 24px;
                            padding-top: 4px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: LayoutAlignment.start;
                                for f in root.files-left: FileLine { file: f; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: LayoutAlignment.start;
                                for f in root.files-right: FileLine { file: f; }
                            }
                        }
                    }

                    // Running log.
                    if root.show-log: Card {
                        vertical-stretch: 1;
                        HorizontalLayout {
                            SectionTitle { glyph: "\u{E7C3}"; text: "Activity"; }
                            Rectangle { horizontal-stretch: 1; }
                            HorizontalLayout {
                                spacing: 12px;
                                LinkText { text: "Open log folder"; clicked => { root.open-logs(); } }
                                Button { text: "Clear"; clicked => { root.clear-log(); } }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 160px;
                            background: Theme.well-background;
                            border-radius: Theme.radius-small;
                            ListView {
                                // Follows the newest line unless the user scrolled up; re-pinned
                                // when lines arrive and when the view or its content resizes (rows
                                // appearing in the progress card above change its height).
                                property <bool> follow: true;
                                property <int> revision: root.log-revision;
                                function pin() {
                                    if (self.follow) {
                                        self.content-y = min(0px, self.visible-height - self.content-height);
                                    }
                                }
                                changed revision => { self.pin(); }
                                changed visible-height => { self.pin(); }
                                changed content-height => { self.pin(); }
                                scrolled => {
                                    self.follow = self.content-y <= self.visible-height - self.content-height + 4px;
                                }
                                for line in root.log-lines: HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 1px;
                                    padding-bottom: 1px;
                                    Text {
                                        text: line;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    if !root.has-folder && !root.show-log: Rectangle {
                        vertical-stretch: 1;
                        min-height: 200px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: #FFFFFF1F;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Glyph { glyph: "\u{E896}"; font-size: 32px; color: Theme.text-tertiary; }
                            Text { text: "Drop files or folders here"; font-size: 16px; color: Theme.text-secondary; horizontal-alignment: center; }
                            Text { text: "Videos, images, audio and documents. Folders include their subfolders."; font-size: 12px; color: Theme.text-tertiary; horizontal-alignment: center; }
                        }
                    }
                    if root.has-folder && root.processing && !root.show-log: Rectangle { vertical-stretch: 1; }
                }
            }

            // ================= Settings
            if root.page == 1: settings-page := ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, settings-column.preferred-height);

                settings-column := VerticalLayout {
                    width: settings-page.visible-width;
                    padding: 24px;
                    padding-left: max(24px, (settings-page.visible-width - 1000px) / 2);
                    padding-right: max(24px, (settings-page.visible-width - 1000px) / 2);
                    spacing: 14px;
                    alignment: LayoutAlignment.start;

                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Settings"; font-size: 26px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.locked ? "Locked" : "Saved automatically";
                            font-size: 12px;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                        }
                        Button { text: "Restore defaults"; enabled: !root.locked; clicked => { root.restore-defaults(); } }
                    }

                    // Why nothing below can be changed now (a run's results depend on its settings).
                    if root.locked: Rectangle {
                        background: #FCE10014;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: #FCE10059;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Glyph { glyph: "\u{E72E}"; font-size: 16px; color: Theme.caution; width: 18px; }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.scanning ? "Settings can't be changed while folders are being scanned"
                                        : "Settings can't be changed while files are being processed";
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.scanning ? "They unlock when the scan finishes."
                                        : "This includes a paused batch. Stop it to change them; the next Start uses the new settings.";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---- videos
                    Card {
                        gap: 16px;
                        GroupHeader {
                            glyph: "\u{E714}";
                            title: "Videos";
                            formats: "mp4, mkv, mov, avi, wmv, webm, flv, m4v, mts, m2ts, ts, 3gp, mpg, mpeg, and animated GIFs over the size limit";
                            enabled: !root.locked;
                            on <=> root.videos-on;
                            toggled => { root.settings-changed(); }
                        }
                        if root.videos-on: GridLayout {
                            spacing-horizontal: 24px;
                            spacing-vertical: 16px;
                            Row {
                                SettingField {
                                    glyph: "\u{E7F4}";
                                    label: "Encoder";
                                    hint: "AV1 makes the smallest files (RTX 40+).";
                                    enabled: !root.locked;
                                    model: root.encoder-options;
                                    current-index <=> root.encoder-index;
                                    changed => { root.settings-changed(); }
                                }
                                SettingField {
                                    glyph: "\u{E9F5}";
                                    label: "Parallel jobs";
                                    hint: "Videos encoded at the same time (4 keeps both NVENC units busy).";
                                    enabled: !root.locked;
                                    model: root.jobs-options;
                                    current-index <=> root.jobs-index;
                                    changed => { root.settings-changed(); }
                                }
                            }
                            Row {
                                SettingField {
                                    glyph: "\u{E7B3}";
                                    label: "Quality";
                                    hint: "More detail means less space saved.";
                                    enabled: !root.locked;
                                    model: root.quality-options;
                                    current-index <=> root.quality-index;
                                    changed => { root.settings-changed(); }
                                }
                                SettingField {
                                    glyph: "\u{EC4A}";
                                    label: "Encoding speed";
                                    hint: "Slower presets compress better.";
                                    enabled: !root.locked;
                                    model: root.speed-options;
                                    current-index <=> root.speed-index;
                                    changed => { root.settings-changed(); }
                                }
                            }
                            Row {
                                SettingField {
                                    glyph: "\u{E73E}";
                                    label: "If not smaller";
                                    hint: "Retry stronger settings, keeping the measured quality (VMAF) at or above this.";
                                    enabled: !root.locked;
                                    model: root.check-options;
                                    current-index <=> root.check-index;
                                    changed => { root.settings-changed(); }
                                }
                                SettingField {
                                    glyph: "\u{E8B9}";
                                    label: "Animated GIFs";
                                    hint: "Smaller GIFs stay GIFs (optimized as images).";
                                    enabled: !root.locked;
                                    model: root.gifs-options;
                                    current-index <=> root.gifs-index;
                                    changed => { root.settings-changed(); }
                                }
                            }
                        }
                    }

                    // ---- images
                    Card {
                        gap: 16px;
                        GroupHeader {
                            glyph: "\u{EB9F}";
                            title: "Images";
                            formats: "png, jpg, jpeg, jpe, jfif, gif, bmp, tga";
                            enabled: !root.locked;
                            on <=> root.images-on;
                            toggled => { root.settings-changed(); }
                        }
                        if root.images-on: GridLayout {
                            spacing-horizontal: 24px;
                            spacing-vertical: 16px;
                            Row {
                                SettingField {
                                    glyph: "\u{E7B3}";
                                    label: "Quality";
                                    hint: "Also used for the pictures inside comics.";
                                    enabled: !root.locked;
                                    model: root.images-options;
                                    current-index <=> root.images-index;
                                    changed => { root.settings-changed(); }
                                }
                                SettingField {
                                    glyph: "\u{E8AC}";
                                    label: "Wrong extensions";
                                    hint: "A JPEG named .png becomes .jpg (may break saved web pages).";
                                    enabled: !root.locked;
                                    model: root.fix-ext-options;
                                    current-index <=> root.fix-ext-index;
                                    changed => { root.settings-changed(); }
                                }
                            }
                        }
                    }

                    // ---- audio
                    Card {
                        gap: 16px;
                        GroupHeader {
                            glyph: "\u{E8D6}";
                            title: "Audio";
                            formats: "flac, mp3, ogg, oga, wav, and lossless m4a (ALAC), aiff, ape, wv, tta (AAC .m4a and other lossy files are left alone)";
                            enabled: !root.locked;
                            on <=> root.audio-on;
                            toggled => { root.settings-changed(); }
                        }
                        if root.audio-on: GridLayout {
                            spacing-horizontal: 24px;
                            Row {
                                SettingField {
                                    glyph: "\u{E7B3}";
                                    label: "Cover art";
                                    hint: "The sound itself never changes.";
                                    enabled: !root.locked;
                                    model: root.audio-options;
                                    current-index <=> root.audio-index;
                                    changed => { root.settings-changed(); }
                                }
                                EmptyField { }
                            }
                        }
                    }

                    // ---- documents
                    Card {
                        gap: 16px;
                        GroupHeader {
                            glyph: "\u{E8A5}";
                            title: "Documents";
                            formats: "pdf, docx, xlsx, pptx (and docm, xlsm, pptm), odt, ods, odp, odg, epub, cbz, cbr";
                            enabled: !root.locked;
                            on <=> root.docs-on;
                            toggled => { root.settings-changed(); }
                        }
                        if root.docs-on: GridLayout {
                            spacing-horizontal: 24px;
                            Row {
                                SettingField {
                                    glyph: "\u{EA90}";
                                    label: "PDF";
                                    hint: "Text and drawings never change; every page is rendered and compared.";
                                    enabled: !root.locked;
                                    model: root.pdf-options;
                                    current-index <=> root.pdf-index;
                                    changed => { root.settings-changed(); }
                                }
                                EmptyField { }
                            }
                        }
                    }

                    // ---- files
                    Card {
                        gap: 16px;
                        GroupHeader {
                            glyph: "\u{E8B7}";
                            title: "Files";
                            formats: "Conversions, replaced originals and work folders";
                            has-switch: false;
                        }
                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                preferred-width: 200px;
                                min-width: 0px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-bottom: 4px;
                                    Glyph { glyph: "\u{E8AB}"; font-size: 14px; color: Theme.text-secondary; width: 16px; }
                                    Text { text: "Conversions"; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                }
                                Check {
                                    text: "All";
                                    enabled: !root.locked;
                                    checked: root.conv-wav && root.conv-img && root.conv-cbr;
                                    clicked => {
                                        if (root.conv-wav && root.conv-img && root.conv-cbr) {
                                            root.conv-wav = false;
                                            root.conv-img = false;
                                            root.conv-cbr = false;
                                        } else {
                                            root.conv-wav = true;
                                            root.conv-img = true;
                                            root.conv-cbr = true;
                                        }
                                        root.settings-changed();
                                    }
                                }
                                Check {
                                    text: "WAV, AIFF, ALAC, APE, WavPack, TTA → FLAC (when smaller)";
                                    enabled: !root.locked;
                                    checked: root.conv-wav;
                                    clicked => { root.conv-wav = !root.conv-wav; root.settings-changed(); }
                                }
                                Check {
                                    text: "BMP / TGA → PNG";
                                    enabled: !root.locked;
                                    checked: root.conv-img;
                                    clicked => { root.conv-img = !root.conv-img; root.settings-changed(); }
                                }
                                Check {
                                    text: "CBR → CBZ";
                                    enabled: !root.locked;
                                    checked: root.conv-cbr;
                                    clicked => { root.conv-cbr = !root.conv-cbr; root.settings-changed(); }
                                }
                                Text { text: "Lossless and verified. The file extension changes."; font-size: 12px; color: Theme.text-tertiary; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                preferred-width: 200px;
                                min-width: 0px;
                                alignment: LayoutAlignment.start;
                                SettingField {
                                    glyph: "\u{E74D}";
                                    label: "Replaced originals";
                                    hint: "Recycle Bin or backup folder: restorable.";
                                    enabled: !root.locked;
                                    model: root.originals-options;
                                    current-index <=> root.originals-index;
                                    changed => { root.settings-changed(); }
                                }
                            }
                        }
                        // Index 1 = "Move to a backup folder".
                        if root.originals-index == 1: HorizontalLayout {
                            spacing: 12px;
                            Glyph { glyph: "\u{E8B7}"; font-size: 13px; color: Theme.text-tertiary; width: 14px; }
                            Text {
                                text: root.backup-dir != ""
                                    ? "Originals go to " + root.backup-dir + ", in the same subfolders."
                                    : "Originals go next to the scanned folder, into \"<folder> (originals)\", in the same subfolders.";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            LinkText { text: "Change folder…"; enabled: !root.locked; clicked => { root.choose-backup-folder(); } }
                            if root.backup-dir != "": LinkText {
                                text: "Use default";
                                enabled: !root.locked;
                                clicked => {
                                    root.backup-dir = "";
                                    root.settings-changed();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Glyph { glyph: "\u{E8B7}"; font-size: 13px; color: Theme.text-tertiary; width: 14px; }
                            Text {
                                text: "Temporary files go to " + (root.temp-dir != "" ? root.temp-dir : root.system-temp)
                                    + " (a drive short on space uses a hidden folder on the file's own drive).";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            LinkText { text: "Change folder…"; enabled: !root.locked; clicked => { root.choose-temp-folder(); } }
                            if root.temp-dir != "": LinkText {
                                text: "Use default";
                                enabled: !root.locked;
                                clicked => {
                                    root.temp-dir = "";
                                    root.settings-changed();
                                }
                            }
                        }
                    }
                }
            }

            // ================= About
            if root.page == 2: about-page := ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, about-column.preferred-height);

                about-column := VerticalLayout {
                    width: about-page.visible-width;
                    padding: 24px;
                    padding-left: max(24px, (about-page.visible-width - 1000px) / 2);
                    padding-right: max(24px, (about-page.visible-width - 1000px) / 2);
                    spacing: 14px;
                    alignment: LayoutAlignment.start;

                    Text { text: "About"; font-size: 26px; font-weight: 600; color: Theme.text; }

                    Card {
                        HorizontalLayout {
                            spacing: 16px;
                            Image { source: @image-url("../assets/icon.png"); width: 48px; height: 48px; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "mediaopti " + root.app-version; font-size: 18px; font-weight: 600; color: Theme.text; }
                                Text {
                                    text: "Makes a media library smaller. A file is replaced only when the result is smaller and passes verification (identical pixels or audio, or SSIMULACRA2 / VMAF ≥ 93); dates and attributes are kept.";
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E895}"; text: "Updates"; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: root.update-text;
                                font-size: 13px;
                                font-weight: root.update-version != "" ? 600 : 400;
                                color: root.update-version != "" ? Theme.text : Theme.text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if root.update-version != "": LinkText { text: "What's new"; clicked => { root.open-release-page(); } }
                            if root.update-version == "" && !root.update-running: LinkText { text: "Check again"; clicked => { root.check-update(); } }
                            if root.update-version != "": Button {
                                text: "Update and restart";
                                primary: true;
                                enabled: !root.locked && !root.update-running;
                                clicked => { root.install-update(); }
                            }
                        }
                        if root.update-version != "": Text {
                            text: root.locked ? "Available when nothing is queued or running." : "The new version is downloaded from GitHub, checked against its published checksum and installed in the app's folder; settings and history are kept.";
                            font-size: 12px;
                            color: Theme.text-tertiary;
                            wrap: word-wrap;
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E90F}"; text: "Tools"; }
                        if root.tool-rows.length == 0: Text { text: "Found: " + root.tools-found; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }
                        for row in root.tool-rows: HorizontalLayout {
                            spacing: 12px;
                            Text { text: row.name; font-size: 13px; color: Theme.text; width: 96px; }
                            Text { text: row.version; font-size: 13px; color: Theme.text-secondary; width: 110px; overflow: elide; }
                            Text { text: row.source; font-size: 12px; color: Theme.text-tertiary; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: root.tools-checking ? "Looking for new pingo and beeim versions…" : root.tools-new-text;
                                font-size: 13px;
                                font-weight: root.tools-new ? 600 : 400;
                                color: root.tools-new ? Theme.text : Theme.text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if !root.tools-new && !root.tools-checking: LinkText { text: "Check again"; clicked => { root.check-tools(); } }
                            if root.tools-new: Button {
                                text: "Install";
                                primary: true;
                                enabled: !root.locked && !root.tools-checking;
                                clicked => { root.install-tools(); }
                            }
                        }
                        if root.tools-missing != "": Text { text: "Missing (their steps are skipped): " + root.tools-missing; font-size: 13px; color: Theme.caution; wrap: word-wrap; }
                        Text {
                            text: "The included tools are updated with mediaopti's releases, after testing (licences in THIRD-PARTY.txt). pingo and beeim (css-ig.net) are free for private use and are never bundled: the app downloads them and looks for new versions once a week, but installs one only when you click Install. Every result is verified either way. Run scripts\\fetch-tools.ps1 to install missing tools.";
                            font-size: 12px;
                            color: Theme.text-tertiary;
                            wrap: word-wrap;
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E8B7}"; text: "Data"; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.data-dir; font-size: 13px; color: Theme.text-secondary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            LinkText { text: "Open folder"; clicked => { root.open-data-folder(); } }
                            LinkText { text: "Open logs"; clicked => { root.open-logs(); } }
                        }
                        Text {
                            text: "Settings, the processed history (by location and by content) and the logs are stored there.";
                            font-size: 12px;
                            color: Theme.text-tertiary;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Glyph { glyph: "\u{E81C}"; font-size: 13px; color: Theme.text-tertiary; width: 14px; }
                            Text { text: root.history-text; font-size: 13px; color: Theme.text-tertiary; vertical-alignment: center; horizontal-stretch: 1; }
                            LinkText {
                                text: "Forget processed history";
                                enabled: !root.busy && root.show-history;
                                clicked => { root.forget-history(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: LayoutAlignment.start;
                        LinkText { text: "Advanced options"; clicked => { root.page = 3; } }
                    }
                }
            }

            // ================= Advanced (only from About)
            if root.page == 3: advanced-page := ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, advanced-column.preferred-height);

                advanced-column := VerticalLayout {
                    width: advanced-page.visible-width;
                    padding: 24px;
                    padding-left: max(24px, (advanced-page.visible-width - 1000px) / 2);
                    padding-right: max(24px, (advanced-page.visible-width - 1000px) / 2);
                    spacing: 14px;
                    alignment: LayoutAlignment.start;

                    HorizontalLayout {
                        spacing: 12px;
                        LinkText { text: "‹ About"; clicked => { root.page = 2; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Advanced options"; font-size: 26px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.locked ? "Locked" : root.adv-default ? "Defaults" : "Changed";
                            font-size: 12px;
                            color: root.adv-default ? Theme.text-tertiary : Theme.caution;
                            vertical-alignment: center;
                        }
                        Button { text: "Restore defaults"; enabled: !root.locked && !root.adv-default; clicked => { root.restore-advanced(); } }
                    }

                    Rectangle {
                        background: #FCE10014;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: #FCE10059;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Glyph { glyph: "\u{E7BA}"; font-size: 16px; color: Theme.caution; width: 18px; }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "These options can break things";
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "They exist for testing and troubleshooting. The defaults were measured on real libraries; other values can make runs much slower, gain nothing, or fail on some systems. Results are still verified before any file is replaced. If something goes wrong, use Restore defaults.";
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E950}"; text: "GPU decoding"; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Decode H.264, HEVC, AV1 and VP9 on the GPU when encoding to AV1 or HEVC (NVENC). The output is identical to CPU decoding; turn it off if the graphics driver misbehaves.";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Switch {
                                text: root.gpu-decoding ? "On" : "Off";
                                enabled: !root.locked;
                                checked <=> root.gpu-decoding;
                                toggled => { root.advanced-changed(); }
                            }
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E74D}"; text: "Remove data tracks"; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Videos with a data track no container can carry over (GoPro telemetry, iPhone metadata) are left as they are. On, they are optimized and lose that track: GPS, sensor and camera data in it is gone. QuickTime VR panoramas and Dolby Vision are always left alone.";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Switch {
                                text: root.drop-data ? "On" : "Off";
                                enabled: !root.locked;
                                checked <=> root.drop-data;
                                toggled => { root.advanced-changed(); }
                            }
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E8EC}"; text: "Remove metadata"; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Removes EXIF (camera, date, GPS), comments and text from PNG, JPEG and GIF (also inside comics, Office and EPUB files) and the empty padding in FLAC and MP3 tags. Colour profiles and rotation are always kept, and so are audio tags.";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Switch {
                                text: root.strip ? "On" : "Off";
                                enabled: !root.locked;
                                checked <=> root.strip;
                                toggled => { root.advanced-changed(); }
                            }
                        }
                        Check {
                            text: "Also redo files already processed without it (they are read and optimized again)";
                            enabled: !root.locked && root.strip;
                            checked: root.redo-stripped;
                            clicked => { root.redo-stripped = !root.redo-stripped; root.advanced-changed(); }
                        }
                    }

                    Card {
                        SectionTitle { glyph: "\u{E9E9}"; text: "Maximum-effort parts"; }
                        Text {
                            text: "Extra optimizer steps for images, audio and PDFs. Each was measured alone; only the default one paid off. Files already in the processed history are not redone when these change.";
                            font-size: 12px;
                            color: Theme.text-tertiary;
                            wrap: word-wrap;
                        }
                        for part[i] in root.adv-parts: VerticalLayout {
                            spacing: 0px;
                            Check {
                                text: part.label;
                                checked: part.on;
                                enabled: !root.locked;
                                clicked => { root.toggle-part(i); }
                            }
                            Text {
                                text: part.detail + "  (" + part.name + ")";
                                font-size: 12px;
                                color: Theme.text-tertiary;
                                wrap: word-wrap;
                                x: 30px;
                                width: parent.width - 30px;
                            }
                        }
                    }
                }
            }
        }
    }

    // Covers the window with an invisible tint that changes when `repaint-all` flips, so the
    // whole window is redrawn (it takes no input).
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.repaint-all ? #00000001 : #00000000;
    }

    // While files are dragged over the window: where they will go.
    if root.drop-hover: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000B0;
        Rectangle {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            height: parent.height - 32px;
            border-radius: Theme.radius;
            border-width: 2px;
            border-color: Theme.accent;
            background: Theme.accent.with-alpha(0.06);
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Glyph { glyph: "\u{E896}"; font-size: 40px; color: Theme.accent; }
                Text {
                    text: root.processing ? "Drop to add them to the running queue" : "Drop to add them to the queue";
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Folders are scanned with their subfolders.";
                    font-size: 13px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
