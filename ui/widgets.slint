// Shared pieces of the mediaopti window: data structs, the theme and small components.

import { Button as StdButton, ComboBox, ListView, ScrollView } from "std-widgets.slint";

// A file being worked on: its name, the folder it is in (shortened), its step, its time so
// far; `progress` < 0 when its share done isn't known.
export struct FileRow {
    name: string,
    folder: string,
    step: string,
    time: string,
    progress: float,
}

// One activity line: the time ("19:49:19"), the message, and its tone: "saved" (stands out),
// "kept" (the bulk: dimmed), "failed", or "" (anything else).
export struct LogLine {
    time: string,
    text: string,
    tone: string,
}

// One external tool on the About page.
export struct ToolRow {
    name: string,
    version: string,
    source: string,
}

// One maximum-effort part on the Advanced page.
export struct AdvPart {
    name: string,
    label: string,
    detail: string,
    on: bool,
}

export struct WorkerRow {
    title: string,
    meta: string,
    progress: float,
}

// A figure of the running batch; `detail` is a smaller note after the value ("of 1,181,903");
// `alert` draws it in the critical colour (failed files).
export struct Metric {
    label: string,
    value: string,
    detail: string,
    glyph: string,
    alert: bool,
}

// Design tokens (Windows 11 dark theme values).
export global Theme {
    in property <string> icon-font: "Segoe Fluent Icons";
    out property <brush> window-background: #202020;
    out property <brush> card-background: #2B2B2B;
    out property <brush> card-stroke: #1C1C1C;
    out property <brush> subtle-fill: #FFFFFF0F;
    out property <brush> text: #FFFFFF;
    out property <brush> text-secondary: #FFFFFFC9;
    out property <brush> text-tertiary: #FFFFFF8A;
    // One accent (Windows 11 dark accent text/fill) for links, progress, focus and "running".
    out property <color> accent: #60CDFF;
    out property <color> accent-hover: #99EBFF;
    out property <brush> well-background: #1C1C1C;
    out property <color> success: #6CCB5F;
    out property <color> caution: #FCE100;
    out property <color> critical: #FF99A4;
    out property <color> neutral: #9D9D9D;
    // Radius scale: cards and tiles 8px, inner wells and focus rings 4px, bars and pills fully round.
    out property <length> radius: 8px;
    out property <length> radius-small: 4px;
}

// Icon from the Segoe Fluent Icons font. Decorative: hidden from screen readers.
export component Glyph inherits Text {
    in property <string> glyph;
    text: glyph;
    accessible-role: none;
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component Card inherits Rectangle {
    in property <length> pad: 16px;
    in property <length> gap: 12px;
    background: Theme.card-background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    vertical-stretch: 0;
    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

export component SectionTitle inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> text;
    spacing: 10px;
    Glyph { glyph: root.glyph; font-size: 16px; color: Theme.text-secondary; width: 18px; }
    Text { text: root.text; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
}

export component StatusPill inherits Rectangle {
    in property <string> status;
    in property <string> label;
    property <color> tone: status == "error" ? Theme.critical
        : (status == "stopping" || status == "paused") ? Theme.caution
        : (status == "ready" || status == "done") ? Theme.success
        : status == "idle" ? Theme.neutral
        : Theme.accent;
    background: tone.with-alpha(0.12);
    border-color: tone.with-alpha(0.45);
    border-width: 1px;
    border-radius: self.height / 2;
    height: 28px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.tone;
            }
        }
        Text { text: root.label; color: root.tone; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
}

export component IconTile inherits Rectangle {
    in property <string> glyph;
    width: 44px;
    height: 44px;
    border-radius: Theme.radius;
    background: Theme.accent.with-alpha(0.12);
    Glyph { glyph: root.glyph; font-size: 20px; color: Theme.accent; }
}

// Text-style button: reachable with Tab, activated with Enter/Space, announced as a button.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    border-radius: Theme.radius-small;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-tertiary : touch.has-hover ? Theme.accent-hover : Theme.accent;
            font-size: 13px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// The Fluent style takes its accent from Windows (any colour the user picked), while the rest
// of the window uses Theme.accent: the accent-coloured controls are drawn here instead, with
// the Fluent dark metrics (32px buttons, 40x20 switch), so the app keeps one accent.

// Primary (accent) button. Secondary buttons stay the style's own.
component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    min-height: 32px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-small;
    background: !root.enabled ? #FFFFFF29
        : touch.pressed ? Theme.accent.with-alpha(0.8)
        : touch.has-hover ? Theme.accent.with-alpha(0.9)
        : Theme.accent;
    label := Text {
        text: root.text;
        font-size: 14px;
        color: root.enabled ? #000000 : #FFFFFF87;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    // Keyboard focus ring, outside the button as in Fluent.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-small + 3px;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.text;
    }
}

// Same interface as the style's Button; `primary` draws it in Theme.accent.
export component Button inherits HorizontalLayout {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0;
    if !root.primary: StdButton { text: root.text; enabled: root.enabled; clicked => { root.clicked(); } }
    if root.primary: AccentButton { text: root.text; enabled: root.enabled; clicked => { root.clicked(); } }
}

// Same interface as the style's Switch, drawn in Theme.accent.
export component Switch inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }
    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    min-height: 32px;
    // Its own width only, like the style's Switch (a Rectangle would stretch).
    horizontal-stretch: 0;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 20px;
                border-radius: 10px;
                border-width: root.checked ? 0px : 1px;
                border-color: root.enabled ? #FFFFFF9E : #FFFFFF5D;
                background: root.checked
                    ? (!root.enabled ? #FFFFFF29 : touch.pressed ? Theme.accent.with-alpha(0.8) : touch.has-hover ? Theme.accent.with-alpha(0.9) : Theme.accent)
                    : (root.enabled && touch.has-hover ? #FFFFFF0F : #0000001A);
                thumb := Rectangle {
                    property <length> size: root.enabled && (touch.has-hover || touch.pressed) ? 14px : 12px;
                    width: self.size;
                    height: self.size;
                    border-radius: self.size / 2;
                    x: root.checked ? parent.width - self.size - 4px : 4px;
                    y: (parent.height - self.size) / 2;
                    background: root.checked ? (root.enabled ? #000000 : #FFFFFF87) : (root.enabled ? #FFFFFFC9 : #FFFFFF5D);
                    animate x, width, height { duration: 120ms; easing: ease-out; }
                }
                // Keyboard focus ring.
                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 13px;
                    border-width: focus.has-focus ? 2px : 0px;
                    border-color: Theme.text;
                }
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: root.enabled ? Theme.text : Theme.text-tertiary;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " ") {
                root.flip();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.flip(); }
    }
}

export component SettingField inherits VerticalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <string> hint;
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback changed();
    spacing: 6px;
    // Equal columns regardless of label/hint length, so the dropdowns line up.
    preferred-width: 200px;
    min-width: 0px;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 8px;
        Glyph { glyph: root.glyph; font-size: 14px; color: Theme.text-secondary; width: 16px; }
        Text { text: root.label; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
    }
    ComboBox {
        // The widget's own minimum follows its text; ignoring it keeps both columns equal.
        min-width: 0px;
        model: root.model;
        current-index <=> root.current-index;
        enabled: root.enabled;
        selected => { root.changed(); }
    }
    Text { text: root.hint; font-size: 12px; color: Theme.text-tertiary; wrap: word-wrap; }
}

// Keeps a lone setting at half width (same column sizing as SettingField).
export component EmptyField inherits Rectangle {
    preferred-width: 200px;
    min-width: 0px;
    horizontal-stretch: 1;
}

// One figure of the running batch as a tile, the same shape as `CountTile` (icon, value with
// its note, label underneath), so the page reads as one set of tiles.
export component MetricTile inherits Rectangle {
    in property <Metric> metric;
    // Same preferred width and stretch for every tile, so each row splits evenly.
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 100px;
    background: Theme.card-background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Glyph { glyph: root.metric.glyph; font-size: 20px; color: root.metric.alert ? Theme.critical : Theme.accent; width: 22px; }
        VerticalLayout {
            alignment: center;
            min-width: 0px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.metric.value; font-size: 18px; font-weight: 600; color: root.metric.alert ? Theme.critical : Theme.text; overflow: elide; min-width: 0px; horizontal-stretch: 0; }
                // Bottom-aligned with a small lift, so it sits on the value's baseline.
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 3px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text { text: root.metric.detail; font-size: 12px; color: Theme.text-tertiary; overflow: elide; }
                }
            }
            Text { text: root.metric.label; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
        }
    }
}

export component ThinBar inherits Rectangle {
    in property <float> progress;
    in property <brush> fill: Theme.accent;
    height: 4px;
    border-radius: 2px;
    background: Theme.subtle-fill;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: 250ms; easing: ease-out; }
    }
}

// One line per file: the file name, its folder (dimmed, cut first), then fixed columns for
// its step, its time and a short bar when its share done is known. The fixed columns keep
// every line's columns aligned and stop the names from moving as the time ticks.
export component FileLine inherits HorizontalLayout {
    in property <FileRow> file;
    property <length> step-width: 132px;
    property <length> time-width: 48px;
    property <length> bar-width: 44px;
    spacing: 10px;
    min-height: 22px;
    // Placed by hand (a layout here would loop on its own width): the folder keeps up to a
    // quarter of the space, the name takes the rest; a short name leaves the folder more.
    Rectangle {
        horizontal-stretch: 1;
        min-width: 0px;
        preferred-width: 100px;
        property <length> gap: 6px;
        property <length> folder-room: root.file.folder == "" ? 0px : min(folder.preferred-width + self.gap, self.width * 0.25);
        name := Text {
            x: 0px;
            width: min(self.preferred-width, max(0px, parent.width - parent.folder-room));
            height: parent.height;
            text: root.file.name;
            font-size: 12px;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
        }
        folder := Text {
            x: name.width + parent.gap;
            width: max(0px, parent.width - self.x);
            height: parent.height;
            text: root.file.folder;
            font-size: 11px;
            color: Theme.text-tertiary;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    Text { text: root.file.step; width: root.step-width; font-size: 11px; color: Theme.text-tertiary; overflow: elide; vertical-alignment: center; }
    Text { text: root.file.time; width: root.time-width; font-size: 11px; color: Theme.text-tertiary; horizontal-alignment: right; vertical-alignment: center; }
    Rectangle {
        width: root.bar-width;
        if root.file.progress >= 0: ThinBar { y: (parent.height - self.height) / 2; width: parent.width; progress: root.file.progress; }
    }
}

export struct QueueItem {
    name: string,
    kind: string,
    size: string,
}

export struct QueueCount {
    label: string,
    count: string,
    size: string,
    glyph: string,
}

// One entry of the side navigation (WinUI NavigationView style): icon, label, and a short
// accent pill on the left when selected.
export component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    in property <bool> compact;
    // A dot on the icon (an update is available).
    in property <bool> badge;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.subtle-fill : touch.has-hover ? #FFFFFF0A : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;
        Glyph { glyph: root.glyph; font-size: 16px; width: 18px; color: Theme.text; }
        if !root.compact: Text { text: root.text; font-size: 14px; color: Theme.text; vertical-alignment: center; }
    }
    if root.badge: Rectangle {
        x: 28px;
        y: parent.height / 2 - 11px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Header of a settings card: icon, title, accepted formats, and an on/off switch.
export component GroupHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> formats;
    in property <bool> has-switch: true;
    in property <bool> enabled: true;
    in-out property <bool> on: true;
    callback toggled();
    spacing: 12px;
    Glyph { glyph: root.glyph; font-size: 18px; color: Theme.accent; width: 20px; }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.title; font-size: 15px; font-weight: 600; color: Theme.text; }
        if root.formats != "": Text { text: root.formats; font-size: 12px; color: Theme.text-tertiary; wrap: word-wrap; }
    }
    if root.has-switch: VerticalLayout {
        alignment: center;
        Switch {
            text: root.on ? "On" : "Off";
            enabled: root.enabled;
            checked <=> root.on;
            toggled => { root.toggled(); }
        }
    }
}

// One tool on the About page: name, version, where it comes from.
export component ToolLine inherits HorizontalLayout {
    in property <ToolRow> tool;
    spacing: 12px;
    Text { text: root.tool.name; font-size: 13px; color: Theme.text; width: 88px; overflow: elide; }
    Text { text: root.tool.version; font-size: 13px; color: Theme.text-secondary; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
    Text { text: root.tool.source; font-size: 12px; color: Theme.text-tertiary; horizontal-stretch: 0; vertical-alignment: center; }
}

// A checkbox drawn from its state only (no internal state), so "All" can follow the others.
export component Check inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: Theme.radius-small;
                // Disabled: dimmer than an enabled empty box (Fluent), never lighter.
                border-width: root.checked && root.enabled ? 0px : 1px;
                border-color: root.enabled ? #FFFFFF8A : #FFFFFF33;
                background: !root.enabled ? (root.checked ? #FFFFFF29 : transparent) : root.checked ? Theme.accent : #00000033;
                if root.checked: Glyph { glyph: "\u{E73E}"; font-size: 12px; color: root.enabled ? #000000 : #FFFFFF87; }
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: root.enabled ? Theme.text : Theme.text-tertiary;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One type in the queue summary: icon, count, size.
export component CountTile inherits Rectangle {
    in property <QueueCount> item;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 100px;
    background: Theme.card-background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Glyph { glyph: root.item.glyph; font-size: 20px; color: Theme.accent; width: 22px; }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.count; font-size: 18px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: root.item.label + " · " + root.item.size; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
        }
    }
}

// A bar for work without a known end (scanning): a segment sliding across.
export component BusyBar inherits Rectangle {
    height: 4px;
    border-radius: 2px;
    background: Theme.subtle-fill;
    clip: true;
    Rectangle {
        width: parent.width * 0.25;
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.accent;
        x: (Math.mod(animation-tick() / 1ms, 1600) / 1600) * (parent.width * 1.25) - self.width;
    }
}

export component PageTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> status;
    in property <string> status-label;
    spacing: 12px;
    Text { text: root.text; font-size: 26px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    if root.status != "idle" && root.status != "": VerticalLayout {
        alignment: center;
        StatusPill { status: root.status; label: root.status-label; horizontal-stretch: 0; }
    }
}
